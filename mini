package Foodproject;

import java.util.Scanner;

public class Foodproject {

 static Scanner sc = new Scanner(System.in);

 static String[] foodItems = {
     "Idli", "Dosa", "Pongal", "Poori","vadai"
 };

 static int[] prices = {10, 20, 35, 30,10};

 static int totalBill = 0;
 static int paidAmount = 0;

 
 static void showFoodItems() {

     System.out.println("\n======= FOOD ITEMS =======");

     for (int i = 0; i < foodItems.length; i++) {
         System.out.println((i + 1) + ". " +
             foodItems[i] + " - Rs." + prices[i]);
     }
 }

 
 static void orderFood() {

     showFoodItems();

     while (true) {

         System.out.print("\nEnter Food Choice (0 to finish): ");
         int choice = sc.nextInt();

         if (choice == 0) {
             break;
         }

         if (choice < 1 || choice > foodItems.length) {
             System.out.println("Invalid Food Choice!");
             continue;
         }

         System.out.print("Enter Quantity: ");
         int quantity = sc.nextInt();

         if (quantity <= 0) {
             System.out.println("Invalid Quantity!");
             continue;
         }

         int amount = prices[choice - 1] * quantity;

         totalBill += amount;

         System.out.println("Food Name: " +
             foodItems[choice - 1]);

         System.out.println("Quantity: " + quantity);

         System.out.println("Item Total: Rs." + amount);

         System.out.println("Current Bill: Rs." + totalBill);
     }
 }

 
 static void payAmount() {

     if (totalBill == 0) {
         System.out.println("Please Order Food First!");
         return;
     }

     System.out.println("\n======= PAYMENT DETAILS =======");
     System.out.println("Total Bill: Rs." + totalBill);
     System.out.println("Already Paid: Rs." + paidAmount);

     int balance = totalBill - paidAmount;

     if (balance <= 0) {
         System.out.println("Payment Already Completed!");
         return;
     }

     System.out.println("Balance Amount: Rs." + balance);

     System.out.print("Enter Payment Amount: ");
     int payment = sc.nextInt();

     if (payment <= 0) {
         System.out.println("Invalid Payment Amount!");
         return;
     }

     paidAmount += payment;

     if (paidAmount >= totalBill) {

         int change = paidAmount - totalBill;

         System.out.println("\nPayment Successful!");
         System.out.println("Change: Rs." + change);
         System.out.println("Bill Paid Successfully!");

     } else {

         System.out.println("Partial Payment Successful!");
         System.out.println("Remaining Amount: Rs." +
             (totalBill - paidAmount));
     }
 }

 
 public static void main(String[] args) {

     int choice;

     System.out.println("================================");
     System.out.println("   WELCOME TO FOOD ORDERING");
     System.out.println("================================");

     do {

         System.out.println("\n========== MAIN MENU ==========");
         System.out.println("1. Show Food order items");
         System.out.println("2. Order Food");
         System.out.println("3. Pay Amount");
         System.out.println("4. Exit");

         System.out.print("\nEnter Your Choice: ");
         choice = sc.nextInt();

         switch (choice) {

             case 1:
                 showFoodItems();
                 break;

             case 2:
                 orderFood();
                 break;

             case 3:
                 payAmount();
                 break;

             case 4:
                 if (totalBill > paidAmount) {
                     System.out.println("Pending Amount: Rs." +
                         (totalBill - paidAmount));
                 }

                 System.out.println("\nThank You!");
                 System.out.println("Enjoy Your Food!");
                 break;

             default:
                 System.out.println("Invalid Choice! Try Again.");
         }

     } while (choice != 4);

     sc.close();
 }
}
